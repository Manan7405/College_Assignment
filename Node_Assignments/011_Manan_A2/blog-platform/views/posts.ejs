<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>The Daily Blog</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
      margin: 0;
      background-color: #ffffff;
      color: #374151;
    }
    .hero {
      background: #111827;
      color: white;
      padding: 60px 20px;
      text-align: center;
    }
    .hero h1 { margin: 0 0 10px 0; font-size: 36px; }
    .hero a {
      color: #a5b4fc;
      text-decoration: none;
      font-weight: 500;
    }
    .hero a:hover { color: #c7d2fe; }
    .container {
      max-width: 800px;
      margin: 40px auto;
      padding: 0 20px;
    }
    .post {
      border-bottom: 1px solid #e5e7eb;
      padding-bottom: 40px;
      margin-bottom: 40px;
    }
    .post:last-child { border-bottom: none; }
    .post h2 { color: #111827; font-size: 28px; margin: 0 0 8px 0; }
    .author-date {
      color: #6b7280;
      font-size: 14px;
      margin-bottom: 20px;
    }
    .author-name { font-weight: 600; color: #374151; }
    .post img {
      width: 100%;
      border-radius: 12px;
      margin-bottom: 20px;
      object-fit: cover;
      max-height: 400px;
    }
    .post-content {
      font-size: 16px;
      line-height: 1.7;
      color: #4b5563;
    }
    .tags { margin-top: 20px; }
    .tag {
      display: inline-block;
      background: #f3f4f6;
      color: #4b5563;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 12px;
      margin-right: 8px;
    }
  </style>
</head>
<body>
  <div class="hero">
    <h1>The Daily Blog</h1>
    <a href="/login">Writer Login &rarr;</a>
  </div>

  <div class="container">
    <% if (posts.length === 0) { %>
      <p style="text-align: center; color: #6b7280; margin-top: 50px;">No articles have been published yet.</p>
    <% } else { %>
      <% posts.forEach(post => { %>
        <article class="post">
          <h2><%= post.title %></h2>
          <div class="author-date">
            By <span class="author-name"><%= post.author.name %></span>
          </div>
          
          <% if (post.image) { %>
            <img src="/<%= post.image %>" alt="Featured Image">
          <% } %>
          
          <div class="post-content">
            <%= post.content %>
          </div>
          
          <div class="tags">
            <% post.tags.forEach(tag => { %>
              <span class="tag">#<%= tag %></span>
            <% }) %>
          </div>
        </article>
      <% }) %>
    <% } %>
  </div>
</body>
</html>